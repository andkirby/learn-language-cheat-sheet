        {"detail": {"label": "Пример", "runs": ["Ich sehe ", {"t": "den Mann", "i": true}, ". — Wen sehe ich?"]}},
        {"detail": {"label": "Самое заметное изменение", "runs": ["Maskulin: der → ", {"t": "den", "b": true}, ", ein → ", {"t": "einen", "b": true}, "."]}}
      ]
    },
    "dativ": {
      "title": "Dativ", "lead": "Wem? — кому? чему?",
