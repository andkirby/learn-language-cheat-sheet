        {"detail": {"label": "Пример", "runs": ["Ich helfe ", {"t": "dem Mann", "i": true}, ". — Wem helfe ich?"]}},
        {"detail": {"label": "Запомни", "runs": ["mit, bei, nach, seit, von, zu, aus → Dativ."]}}
      ]
    },
    "genitiv": {
      "title": "Genitiv", "lead": "Wessen? — чей? кого/чего?",
      "blocks": [
        {"detail": {"label": "Часто", "runs": ["Принадлежность или связь."]}},
