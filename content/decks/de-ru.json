        {"detail": {"label": "Форма", "runs": ["Maskulin/Neutrum: des + существительное часто -s/-es."]}}
      ]
    },
    "wo-wohin": {
      "title": "Wo? / Wohin?", "lead": "Это правило связано с Wechselpräpositionen.",
      "blocks": [
        {"detail": {"label": "Wo? → Dativ", "runs": ["Статичное местоположение: Ich bin ", {"t": "in der Schule", "i": true}, "."]}},
        {"detail": {"label": "Wohin? → Akkusativ", "runs": ["Направление/смена положения относительно места: Ich gehe ", {"t": "in die Schule", "i": true}, "."]}},
        {"detail": {"label": "Важно", "runs": ["Не любое движение автоматически означает Akkusativ. Спроси: меняется ли положение относительно границы, которую задаёт предлог? ", {"t": "Ich jogge im Park", "i": true}, " (движение внутри — Dat.) · ", {"t": "Ich jogge in den Park", "i": true}, " (вхожу в парк — Akk.)."]}}
      ]
    },
    "objects": {
      "title": "Два объекта", "lead": "Некоторые глаголы требуют сразу два объекта: кому (Dat.) + что (Akk.).",
      "blocks": [
        {"detail": {"label": "Такие глаголы", "runs": ["geben, schenken, zeigen, bringen, sagen, erklären…"]}},
        {"detail": {"label": "geben", "runs": ["Ich gebe ", {"t": "dem Kind", "i": true}, " (Wem? Dat.) ", {"t": "das Buch", "i": true}, " (Was? Akk.)."]}},
        {"detail": {"label": "Типовая логика", "runs": ["Кому? = получатель → Dativ. Что? = передаваемая вещь → Akkusativ."]}}
      ]
    },
    "possessives": {
      "title": "Притяжательные", "lead": "mein, dein, sein, ihr, unser, euer, ihr, Ihr",
      "blocks": [
        {"detail": {"label": "Значения", "runs": ["мой, твой, его, её, наш, ваш, их, Ваш."]}},
        {"detail": {"label": "Модель", "runs": ["Склоняются как ein-слова. Поэтому: mein Bruder → meinen Bruder → meinem Bruder → meines Bruders. То же с любой основой: dein Bruder → deinen Bruder → deinem Bruder."]}}
      ]
    },
    "why-ein-endings": {
      "title": "Почему meinen / meinem?", "lead": "Окончание — как у артикля: den → meinen, dem → meinem, der → meiner.",
      "blocks": [
        {"detail": {"label": "Ключ", "runs": ["Окончания те же, что у определённого артикля. Сравни: den Mann → ", {"t": "meinen", "i": true}, " Mann · dem Mann → ", {"t": "meinem", "i": true}, " Mann · der Frau → ", {"t": "meiner", "i": true}, " Frau."]}},
        {"detail": {"label": "Где окончания нет", "runs": ["Только три клетки: Nom. m/n и Akk. n — ", {"t": "ein Mann, ein Kind", "i": true}, ". Там форма без окончания, как в der-таблице der/das."]}},
        {"detail": {"label": "Akkusativ", "runs": ["Видимо меняется только Maskulin: der → ", {"t": "den", "i": true}, ", mein → ", {"t": "meinen", "i": true}, ". Fem./Neut./Plural выглядят как Nominativ."]}},
        {"detail": {"label": "Dativ", "runs": ["Различает всё: m/n → ", {"t": "-em", "i": true}, ", f → ", {"t": "-er", "i": true}, ", Plural → ", {"t": "-en", "i": true}, " (+ -n у существительного)."]}}
      ]
    },
    "ihrem": {
      "title": "Почему “ihрем”?", "lead": "ihr + окончание Dativ.",
      "blocks": [
        {"detail": {"label": "Maskulin / Neutrum, Dativ", "runs": ["ihr + -em = ", {"t": "ihrem", "b": true}, "."]}},
        {"detail": {"label": "Примеры", "runs": ["mit ", {"t": "ihrem Bruder", "b": true}, "; mit ", {"t": "ihrem Kind", "b": true}, "."]}},
        {"detail": {"label": "Но", "runs": ["Feminin: mit ", {"t": "ihrer Mutter", "b": true}, ". Plural: mit ", {"t": "ihren Freunden", "b": true}, "."]}}
      ]
    },
